keeps the NodePort Service stable:
  1: |
    ports:
      - name: http
        nodePort: 30080
        port: 8080
        protocol: TCP
        targetPort: http
    selector:
      app.kubernetes.io/instance: RELEASE-NAME
      app.kubernetes.io/name: shipping-service
    type: NodePort
keeps the default ConfigMap stable:
  1: |
    apiVersion: v1
    data:
      DEPLOY_ENV: dev
      KAFKA_ENABLED: "false"
      KAFKA_TOPIC_DISPATCHED: shipment.dispatched
      LOG_LEVEL: INFO
      SERVICE_NAME: RELEASE-NAME-shipping-service
      SERVICE_VERSION: 0.1.0
      SHIPPING_DEFAULT_CARRIER: ACME-Post
      SHIPPING_STORAGE: memory
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: shipping-service
        app.kubernetes.io/part-of: shipping-platform
        app.kubernetes.io/version: 0.1.0
        helm.sh/chart: shipping-service-0.14.0
      name: RELEASE-NAME-shipping-service
