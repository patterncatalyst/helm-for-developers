{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "defaultCarrier": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "enum": [
            "memory",
            "postgres"
          ]
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKeys": {
          "type": "object",
          "properties": {
            "database": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          }
        },
        "password": {
          "type": "string"
        }
      }
    },
    "kafka": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bootstrap": {
          "type": "string"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hooks": {
          "type": "string",
          "pattern": "^(pre|post)-(install|upgrade)(,(pre|post)-(install|upgrade))*$"
        },
        "weight": {
          "type": "integer"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "otel": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        }
      }
    },
    "dataProduct": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "probes": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "tests": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "storage": {
                "const": "postgres"
              }
            },
            "required": [
              "storage"
            ]
          }
        },
        "required": [
          "config"
        ]
      },
      "then": {
        "properties": {
          "postgres": {
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "required": [
          "postgres"
        ]
      }
    }
  ]
}
